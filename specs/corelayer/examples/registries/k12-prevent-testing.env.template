# K12 Prevent testing configuration for dev04.x4app.dev.
# Fill empty values privately, outside Git. See docs/k12-prevent-setup.md.
# Required values are approved testing values; do not reuse mastra-testing.

# K12/repository credential owner: read access to X4Org/bta-contracts.
BTA_CONTRACTS_TOKEN=

# CoreLayer + K12 owner: existing testing client, issuer and BTA policy.
OIDC_ISSUER=
EXPECTED_AUDIENCE=

# CoreLayer owner: read-only testing directory client and its sync/private APIs.
CL_CREDENTIAL_ENVIRONMENT=
CL_CLIENT_ID=
CL_KEY_ID=
CL_PRIVATE_KEY=
SYNC_API_URL=
PRIVATE_API_URL=
# Project-owned scheduling flag; true initializes a fresh preview roster.
SYNC_SCHEDULE_ENABLED=true

# K12/provider credential owners: approved testing credentials.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
RESEND_API_KEY=
LINEAR_API_KEY=

# K12 owner: team test inbox addresses and optional approved sender.
NOTIFICATION_EMAIL_TO=
FEEDBACK_EMAIL_TO=
# RESEND_FROM_EMAIL=

# The frontend's VITE_* settings are not set here. The profile gives each sandbox
# its own preview origins, and points VITE_OIDC_ISSUER and VITE_TOKEN_EXCHANGE_URL
# at X4's sign-in relay (https://auth.x4app.dev/p/corelayer-testing).
